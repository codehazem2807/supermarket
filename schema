-- 15.6 handle_new_user (SAFE — doesn't break auth on failure)
CREATE OR REPLACE FUNCTION handle_new_user() RETURNS trigger
LANGUAGE plpgsql SECURITY DEFINER SET search_path = public, pg_temp AS $$
DECLARE
  v_company uuid;
  v_branch uuid;
  v_role uuid;
  v_is_owner boolean;
  v_full_name text;
  v_username text;
BEGIN
  BEGIN v_company := (new.raw_user_meta_data->>'company_id')::uuid; EXCEPTION WHEN others THEN v_company := NULL; END;
  BEGIN v_branch := (new.raw_user_meta_data->>'branch_id')::uuid; EXCEPTION WHEN others THEN v_branch := NULL; END;
  BEGIN v_role := (new.raw_user_meta_data->>'role_id')::uuid; EXCEPTION WHEN others THEN v_role := NULL; END;
  v_is_owner := COALESCE((new.raw_user_meta_data->>'is_owner')::boolean, false);
  v_full_name := COALESCE(new.raw_user_meta_data->>'full_name', new.email);
  v_username := new.raw_user_meta_data->>'username';

  INSERT INTO public.users(id, company_id, branch_id, role_id, full_name, email, username, is_owner, status, is_active)
  VALUES (new.id, v_company, v_branch, v_role, v_full_name, new.email, v_username, v_is_owner, 'active', true)
  ON CONFLICT (id) DO UPDATE SET
    company_id = COALESCE(excluded.company_id, users.company_id),
    branch_id = COALESCE(excluded.branch_id, users.branch_id),
    role_id = COALESCE(excluded.role_id, users.role_id),
    full_name = COALESCE(excluded.full_name, users.full_name),
    is_owner = users.is_owner OR excluded.is_owner,
    is_active = true;

  RETURN new;
EXCEPTION WHEN others THEN
  RAISE WARNING 'handle_new_user failed: % (%), but allowing auth to continue', SQLERRM, SQLSTATE;
  RETURN new;
END $$;
DROP TRIGGER IF EXISTS on_auth_user_created ON auth.users;
CREATE TRIGGER on_auth_user_created AFTER INSERT ON auth.users
FOR EACH ROW EXECUTE FUNCTION handle_new_user();

