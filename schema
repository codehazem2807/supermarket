-- 17.1 pick_stock_fefo
CREATE OR REPLACE FUNCTION pick_stock_fefo(
  p_company uuid, p_branch uuid, p_warehouse uuid, p_product uuid, p_qty numeric
) RETURNS TABLE(lot_id uuid, lot_number text, take_qty numeric, unit_cost numeric, sale_price numeric, expiry_date date)
LANGUAGE plpgsql SECURITY DEFINER SET search_path = public, pg_temp AS $$
DECLARE r record; remaining numeric := p_qty;
BEGIN
  FOR r IN
    SELECT sl.* FROM stock_lots sl
    WHERE sl.company_id = p_company AND sl.branch_id = p_branch
      AND sl.warehouse_id = p_warehouse AND sl.product_id = p_product
      AND sl.quantity_left > 0 AND sl.is_quarantined = false
    ORDER BY sl.expiry_date ASC, sl.received_at ASC
  LOOP
    EXIT WHEN remaining <= 0;
    DECLARE take numeric := LEAST(remaining, r.quantity_left);
    BEGIN
      lot_id := r.id; lot_number := r.lot_number; take_qty := take;
      unit_cost := r.effective_unit_cost; sale_price := r.sale_price; expiry_date := r.expiry_date;
      remaining := remaining - take;
      RETURN NEXT;
    END;
  END LOOP;
  IF remaining > 0 THEN
    RAISE EXCEPTION 'Insufficient stock for product % (missing %)', p_product, remaining;
  END IF;
END $$;

-- 17.2 record_invoice
CREATE OR REPLACE FUNCTION record_invoice(
  p_company uuid, p_branch uuid, p_warehouse uuid,
  p_register uuid, p_session uuid, p_customer uuid,
  p_items jsonb, p_method payment_method, p_paid numeric, p_notes text DEFAULT NULL
) RETURNS uuid
LANGUAGE plpgsql SECURITY DEFINER SET search_path = public, pg_temp AS $$
DECLARE
  v_invoice uuid := gen_random_uuid();
  v_number text;
  v_subtotal numeric := 0; v_total numeric := 0; v_remaining numeric := 0;
  it jsonb; v_pick record;
  v_account uuid;
BEGIN
  v_number := 'INV-' || to_char(now(),'YYYY') || '-' || substr(v_invoice::text,1,8);

  INSERT INTO sales_invoices(id, company_id, branch_id, warehouse_id, register_id, session_id,
    customer_id, invoice_number, subtotal, total, paid, remaining, payment_method, status, notes, created_by)
  VALUES (v_invoice, p_company, p_branch, p_warehouse, p_register, p_session,
    p_customer, v_number, 0, 0, COALESCE(p_paid,0), 0, p_method, 'paid', p_notes, auth.uid());

  FOR it IN SELECT * FROM jsonb_array_elements(p_items) LOOP
    FOR v_pick IN SELECT * FROM pick_stock_fefo(p_company, p_branch, p_warehouse, (it->>'product_id')::uuid, (it->>'quantity')::numeric) LOOP
      INSERT INTO sales_invoice_items(invoice_id, product_id, lot_id, quantity, unit_price, unit_cost)
      VALUES (v_invoice, (it->>'product_id')::uuid, v_pick.lot_id, v_pick.take_qty,
              COALESCE((it->>'unit_price')::numeric, v_pick.sale_price), v_pick.unit_cost);

      UPDATE stock_lots SET quantity_left = quantity_left - v_pick.take_qty WHERE id = v_pick.lot_id;

      INSERT INTO inventory_movements(company_id, branch_id, warehouse_id, product_id, lot_id,
        movement_type, quantity, unit_cost, reference_type, reference_id, created_by)
      VALUES (p_company, p_branch, p_warehouse, (it->>'product_id')::uuid, v_pick.lot_id,
        'out', v_pick.take_qty, v_pick.unit_cost, 'sale', v_invoice, auth.uid());

      v_subtotal := v_subtotal + v_pick.take_qty * COALESCE((it->>'unit_price')::numeric, v_pick.sale_price);
    END LOOP;
  END LOOP;

  v_total := v_subtotal;
  v_remaining := v_total - COALESCE(p_paid,0);

  UPDATE sales_invoices SET
    subtotal = v_subtotal,
    total = v_total,
    remaining = v_remaining,
    status = CASE
      WHEN v_remaining <= 0 THEN 'paid'::invoice_status
      WHEN COALESCE(p_paid,0) > 0 THEN 'partial'::invoice_status
      ELSE 'credit'::invoice_status
    END
  WHERE id = v_invoice;

  IF p_session IS NOT NULL THEN
    UPDATE pos_sessions SET total_sales = COALESCE(total_sales,0) + v_total WHERE id = p_session;
  END IF;

  SELECT id INTO v_account FROM accounts
    WHERE company_id = p_company AND branch_id = p_branch AND account_type = 'cash' LIMIT 1;

  IF p_customer IS NOT NULL THEN
    IF v_remaining > 0 THEN
      INSERT INTO account_transactions(company_id, branch_id, account_id, direction, amount,
        operation_type, reference_type, reference_id, notes, created_by)
      VALUES (p_company, p_branch, v_account, 'out', v_remaining, 'sale', 'customer', p_customer,
        'فاتورة آجلة #' || v_number, auth.uid());
    END IF;

    IF COALESCE(p_paid,0) > 0 AND v_account IS NOT NULL THEN
      INSERT INTO account_transactions(company_id, branch_id, account_id, direction, amount,
        operation_type, reference_type, reference_id, notes, created_by)
      VALUES (p_company, p_branch, v_account, 'in', p_paid, 'payment', 'customer', p_customer,
        'دفعة على فاتورة #' || v_number, auth.uid());
    END IF;

    INSERT INTO loyalty_points(company_id, customer_id, points, reason, reference_type, reference_id)
    VALUES (p_company, p_customer, FLOOR(v_total / 10)::int, 'نقاط من فاتورة', 'invoice', v_invoice)
    ON CONFLICT DO NOTHING;

