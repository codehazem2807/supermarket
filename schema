-- 17.28 ai_execute_query (SAFE SELECT only)
CREATE OR REPLACE FUNCTION ai_execute_query(p_sql text, p_max_rows int DEFAULT 100)
RETURNS jsonb
LANGUAGE plpgsql SECURITY DEFINER SET search_path = public, pg_temp AS $$
DECLARE
  v_result jsonb;
  v_upper text;
BEGIN
  v_upper := upper(trim(p_sql));
  
  IF v_upper NOT LIKE 'SELECT%' AND v_upper NOT LIKE 'WITH%' THEN
    RAISE EXCEPTION 'Only SELECT queries are allowed';
  END IF;
  
  IF v_upper ~ '\b(INSERT|UPDATE|DELETE|DROP|ALTER|TRUNCATE|CREATE|GRANT|REVOKE)\b' THEN
    RAISE EXCEPTION 'Only SELECT queries are allowed';
  END IF;

  EXECUTE format('SELECT jsonb_agg(t) FROM (SELECT * FROM (%s) sub LIMIT %s) t', p_sql, p_max_rows) INTO v_result;
  
  RETURN COALESCE(v_result, '[]'::jsonb);
END $$;

