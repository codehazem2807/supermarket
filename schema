CREATE OR REPLACE FUNCTION record_return(
  p_company uuid, p_branch uuid, p_original_invoice uuid,
  p_items jsonb, p_refund_method payment_method, p_reason text
) RETURNS uuid
LANGUAGE plpgsql SECURITY DEFINER SET search_path = public, pg_temp AS $$
DECLARE v_id uuid := gen_random_uuid(); v_num text; it jsonb; v_total numeric := 0;
BEGIN
  v_num := 'RET-' || to_char(now(),'YYYY') || '-' || substr(v_id::text,1,8);
  INSERT INTO sales_returns(id, company_id, branch_id, original_invoice_id, return_number,
    refund_method, reason, created_by)
  VALUES (v_id, p_company, p_branch, p_original_invoice, v_num, p_refund_method, p_reason, auth.uid());

  FOR it IN SELECT * FROM jsonb_array_elements(p_items) LOOP
    INSERT INTO sales_return_items(return_id, product_id, lot_id, quantity, unit_price)
    VALUES (v_id, (it->>'product_id')::uuid, (it->>'lot_id')::uuid,
            (it->>'quantity')::numeric, (it->>'unit_price')::numeric);

    IF (it->>'lot_id') IS NOT NULL THEN
      UPDATE stock_lots SET quantity_left = quantity_left + (it->>'quantity')::numeric
      WHERE id = (it->>'lot_id')::uuid;
    END IF;

    INSERT INTO inventory_movements(company_id, branch_id, warehouse_id, product_id, lot_id,
      movement_type, quantity, unit_cost, reference_type, reference_id, created_by)
    VALUES (p_company, p_branch, NULL, (it->>'product_id')::uuid, (it->>'lot_id')::uuid,
      'return', (it->>'quantity')::numeric, 0, 'return', v_id, auth.uid());

    v_total := v_total + (it->>'quantity')::numeric * (it->>'unit_price')::numeric;
  END LOOP;

  UPDATE sales_returns SET total = v_total WHERE id = v_id;

  UPDATE pos_sessions SET total_returns = COALESCE(total_returns,0) + v_total
  WHERE id = (SELECT session_id FROM sales_invoices WHERE id = p_original_invoice);

  RETURN v_id;
END $$;

