  SUM(discount) AS discount, SUM(tax) AS tax, SUM(total) AS total, SUM(paid) AS paid
FROM sales_invoices
WHERE status <> 'voided'
GROUP BY company_id, branch_id, DATE(invoice_date);

-- 14.4 v_low_stock
CREATE OR REPLACE VIEW v_low_stock AS
SELECT p.company_id, p.id AS product_id, p.name, p.min_stock, p.cost_price,
  COALESCE(SUM(sl.quantity_left), 0) AS on_hand
FROM products p
LEFT JOIN stock_lots sl ON sl.product_id = p.id AND sl.is_quarantined = false
WHERE p.is_active = true AND p.deleted_at IS NULL
GROUP BY p.company_id, p.id, p.name, p.min_stock, p.cost_price
HAVING COALESCE(SUM(sl.quantity_left), 0) <= p.min_stock;

-- 14.5 v_expiring_lots
CREATE OR REPLACE VIEW v_expiring_lots AS
SELECT company_id, branch_id, warehouse_id, product_id, id AS lot_id,
  lot_number, quantity_left, expiry_date,
  (expiry_date - current_date) AS days_to_expiry
FROM stock_lots
WHERE quantity_left > 0 AND is_quarantined = false
  AND expiry_date <= current_date + interval '30 days'
ORDER BY expiry_date ASC;

-- 14.6 v_stock_on_hand
CREATE OR REPLACE VIEW v_stock_on_hand AS
SELECT company_id, branch_id, warehouse_id, product_id,
  SUM(quantity_left) AS on_hand
FROM stock_lots
WHERE is_quarantined = false
GROUP BY company_id, branch_id, warehouse_id, product_id;

-- 14.7 v_stock_on_hand_all (includes bundles)
DROP VIEW IF EXISTS v_stock_on_hand_all CASCADE;
CREATE OR REPLACE VIEW v_stock_on_hand_all AS
WITH product_stock AS (
  SELECT sl.company_id, sl.product_id, SUM(sl.quantity_left) AS on_hand
  FROM stock_lots sl
  WHERE sl.is_quarantined = false
  GROUP BY sl.company_id, sl.product_id
)
SELECT
  p.company_id,
  p.id AS product_id,
  p.name,
  p.is_bundle,
  p.base_unit,
  p.sale_unit,
  CASE
    WHEN p.is_bundle THEN
      COALESCE((
        SELECT MIN(FLOOR(COALESCE(ps.on_hand, 0) / NULLIF(bi.quantity, 0)))
        FROM bundle_items bi
        LEFT JOIN product_stock ps ON ps.product_id = bi.component_product_id AND ps.company_id = p.company_id
        WHERE bi.bundle_product_id = p.id AND bi.company_id = p.company_id
      ), 0)
    ELSE
      COALESCE((
        SELECT on_hand FROM product_stock ps
        WHERE ps.product_id = p.id AND ps.company_id = p.company_id
      ), 0)
  END AS on_hand
FROM products p
WHERE p.deleted_at IS NULL;

-- 14.8 v_pos_session_summary
