-- 15.9 Low stock trigger
CREATE OR REPLACE FUNCTION check_low_stock() RETURNS trigger
LANGUAGE plpgsql SECURITY DEFINER SET search_path = public, pg_temp AS $$
DECLARE
  v_product record;
  v_total numeric;
BEGIN
  IF new.quantity_left >= COALESCE(old.quantity_left, 0) THEN
    RETURN new;
  END IF;

  SELECT id, name, min_stock, company_id INTO v_product
  FROM products WHERE id = new.product_id;

  IF v_product.min_stock IS NULL OR v_product.min_stock <= 0 THEN
    RETURN new;
  END IF;

  SELECT COALESCE(SUM(quantity_left), 0) INTO v_total
  FROM stock_lots
  WHERE product_id = new.product_id AND is_quarantined = false AND quantity_left > 0;

  IF v_total <= v_product.min_stock AND v_total + (old.quantity_left - new.quantity_left) > v_product.min_stock THEN
    BEGIN
      INSERT INTO notifications(company_id, type, title, body, link, severity, entity_type, entity_id)
      VALUES (
        v_product.company_id,
        'low_stock',
        'نقص مخزون: ' || v_product.name,
        'المتبقي ' || v_total || ' — الحد الأدنى ' || v_product.min_stock,
        'inventory.html',
        'warning',
        'product',
        v_product.id
      );
    EXCEPTION WHEN others THEN
      RAISE WARNING 'low_stock notification failed: %', SQLERRM;
    END;
  END IF;

  RETURN new;
END $$;
DROP TRIGGER IF EXISTS trg_low_stock ON stock_lots;
CREATE TRIGGER trg_low_stock AFTER UPDATE ON stock_lots
FOR EACH ROW EXECUTE FUNCTION check_low_stock();

