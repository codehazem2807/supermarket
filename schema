-- 15.1 set_updated_at
CREATE OR REPLACE FUNCTION set_updated_at() RETURNS trigger
LANGUAGE plpgsql AS $$
BEGIN new.updated_at = now(); RETURN new; END $$;

DO $$
DECLARE t text;
BEGIN
  FOREACH t IN ARRAY ARRAY[
    'companies','branches','roles','users','subscriptions','categories',
    'warehouses','warehouse_zones','warehouse_locations','warehouse_counts',
    'suppliers','customers','products','purchase_orders',
    'stock_lots','stock_transfers','sales_invoices','accounts',
    'store_settings','store_orders','company_settings',
    'chat_conversations','notification_preferences','offline_queue'
  ] LOOP
    IF EXISTS (SELECT 1 FROM information_schema.tables WHERE table_name = t AND table_schema = 'public') THEN
      EXECUTE format('DROP TRIGGER IF EXISTS trg_%1$s_updated ON %1$s', t);
      EXECUTE format('CREATE TRIGGER trg_%1$s_updated BEFORE UPDATE ON %1$s
                      FOR EACH ROW EXECUTE FUNCTION set_updated_at()', t);
    END IF;
  END LOOP;
END $$;

-- 15.2 stock_lots guard
CREATE OR REPLACE FUNCTION stock_lots_guard() RETURNS trigger
LANGUAGE plpgsql AS $$
BEGIN
  IF new.expiry_date IS NULL THEN
    RAISE EXCEPTION 'expiry_date is mandatory for every stock lot';
  END IF;
  IF new.quantity_left < 0 THEN
    RAISE EXCEPTION 'quantity_left cannot be negative';
  END IF;
  RETURN new;
END $$;
DROP TRIGGER IF EXISTS trg_sl_guard ON stock_lots;
CREATE TRIGGER trg_sl_guard BEFORE INSERT OR UPDATE ON stock_lots
FOR EACH ROW EXECUTE FUNCTION stock_lots_guard();

-- 15.3 products guard
CREATE OR REPLACE FUNCTION products_guard() RETURNS trigger
LANGUAGE plpgsql AS $$
BEGIN
  IF COALESCE(new.barcode,'') = '' AND COALESCE(new.plu_code,'') = '' AND NOT new.is_bundle THEN
    RAISE EXCEPTION 'Product must have barcode OR plu_code (or is_bundle)';
  END IF;
  RETURN new;
END $$;
DROP TRIGGER IF EXISTS trg_products_guard ON products;
CREATE TRIGGER trg_products_guard BEFORE INSERT OR UPDATE ON products
FOR EACH ROW EXECUTE FUNCTION products_guard();

-- 15.4 users guard (owner immutable + one owner)
CREATE OR REPLACE FUNCTION users_guard() RETURNS trigger
LANGUAGE plpgsql AS $$
BEGIN
  IF tg_op = 'DELETE' THEN
    IF old.is_owner THEN
      RAISE EXCEPTION 'Owner cannot be deleted';
    END IF;
    RETURN old;
  END IF;
  IF tg_op = 'UPDATE' AND old.is_owner AND NOT new.is_owner THEN
    RAISE EXCEPTION 'Owner cannot be demoted';
  END IF;
  IF new.is_owner THEN
    IF EXISTS(SELECT 1 FROM users WHERE company_id = new.company_id AND is_owner = true AND id <> new.id) THEN
      RAISE EXCEPTION 'Only one owner per company';
    END IF;
  END IF;
  RETURN new;
END $$;
DROP TRIGGER IF EXISTS trg_users_guard ON users;
