  p_customer_notes text DEFAULT NULL,
  p_payment_method text DEFAULT 'cash',
  p_fulfillment_type text DEFAULT 'delivery',
  p_items jsonb DEFAULT '[]'::jsonb,
  p_scheduled_at timestamptz DEFAULT NULL
) RETURNS jsonb
LANGUAGE plpgsql SECURITY DEFINER SET search_path = public, pg_temp AS $$
DECLARE
  v_order_id uuid := gen_random_uuid();
  v_order_number text;
  v_customer_id uuid;
  v_settings record;
  v_subtotal numeric := 0;
  v_delivery_fee numeric := 0;
  v_total numeric := 0;
  v_item jsonb;
  v_product record;
  v_branch_id uuid;
BEGIN
  -- Get settings
  SELECT * INTO v_settings FROM store_settings WHERE company_id = p_company_id AND enabled = true;
  IF NOT FOUND THEN
    RETURN jsonb_build_object('ok', false, 'error', 'store_disabled');
  END IF;

  -- Check min order
  IF v_settings.min_order_amount > 0 THEN
    FOR v_item IN SELECT * FROM jsonb_array_elements(p_items) LOOP
      v_subtotal := v_subtotal + ((v_item->>'quantity')::numeric * (v_item->>'unit_price')::numeric);
    END LOOP;
    IF v_subtotal < v_settings.min_order_amount THEN
      RETURN jsonb_build_object('ok', false, 'error', 'min_order_not_met');
    END IF;
  END IF;

  -- Get default branch
  SELECT id INTO v_branch_id FROM branches WHERE company_id = p_company_id AND is_main = true LIMIT 1;
  IF v_branch_id IS NULL THEN
    SELECT id INTO v_branch_id FROM branches WHERE company_id = p_company_id LIMIT 1;
  END IF;

  -- Register/get customer
  v_customer_id := register_store_customer(p_company_id, p_customer_name, p_customer_phone, NULL, auth.uid());

  -- Order number
  v_order_number := 'SO-' || to_char(now(),'YYYYMMDD') || '-' || substr(v_order_id::text,1,6);

  -- Calculate subtotal from items (recalculate from DB prices for security)
  v_subtotal := 0;
  FOR v_item IN SELECT * FROM jsonb_array_elements(p_items) LOOP
    SELECT id, name, COALESCE(store_price, sale_price) AS price, image_url INTO v_product
    FROM products WHERE id = (v_item->>'product_id')::uuid AND company_id = p_company_id;

    IF FOUND THEN
      v_subtotal := v_subtotal + ((v_item->>'quantity')::numeric * v_product.price);
    END IF;
  END LOOP;

  -- Delivery fee
  IF p_fulfillment_type = 'delivery' THEN
    IF v_settings.free_delivery_threshold IS NOT NULL AND v_subtotal >= v_settings.free_delivery_threshold THEN
      v_delivery_fee := 0;
    ELSE
      v_delivery_fee := COALESCE(v_settings.delivery_fee, 0);
    END IF;
  END IF;

  v_total := v_subtotal + v_delivery_fee;

  -- Insert order (status = pending, scheduled_at could be set for closed store)
  INSERT INTO store_orders(
    id, company_id, branch_id, order_number, customer_id,
    customer_name, customer_phone, customer_address, customer_notes,
    subtotal, delivery_fee, total, payment_method, payment_status, status,
    fulfillment_type, scheduled_at
  ) VALUES (
    v_order_id, p_company_id, v_branch_id, v_order_number, v_customer_id,
    p_customer_name, p_customer_phone, p_customer_address, p_customer_notes,
    v_subtotal, v_delivery_fee, v_total, p_payment_method, 'pending', 'pending',
    p_fulfillment_type, p_scheduled_at
  );

  -- Insert items
  FOR v_item IN SELECT * FROM jsonb_array_elements(p_items) LOOP
    SELECT id, name, COALESCE(store_price, sale_price) AS price, image_url INTO v_product
    FROM products WHERE id = (v_item->>'product_id')::uuid AND company_id = p_company_id;

    IF FOUND THEN
      INSERT INTO store_order_items(order_id, product_id, product_name, product_image, quantity, unit_price, line_total)
      VALUES (
        v_order_id, v_product.id, v_product.name, v_product.image_url,
        (v_item->>'quantity')::numeric, v_product.price,
        (v_item->>'quantity')::numeric * v_product.price
      );
    END IF;
  END LOOP;

  -- Try to create notification (SAFE)
  BEGIN
    PERFORM create_notification(
      p_company_id, 'store_order',
      'طلب متجر جديد #' || v_order_number,
      p_customer_name || ' — ' || v_total || ' ج.م',
      'store-orders.html', 'info', NULL, 'store_order', v_order_id
    );
  EXCEPTION WHEN others THEN
    RAISE WARNING 'create_store_order notification failed: %', SQLERRM;
  END;

  RETURN jsonb_build_object(
    'ok', true, 
    'order_id', v_order_id, 
    'order_number', v_order_number,
    'total', v_total,
    'scheduled_at', p_scheduled_at
  );
END $$;

-- 17.26 generate_company_slug
CREATE OR REPLACE FUNCTION generate_company_slug(p_name text) RETURNS text
LANGUAGE plpgsql SECURITY DEFINER SET search_path = public, pg_temp AS $$
DECLARE
  v_base text;
  v_slug text;
  v_counter int := 0;
BEGIN
  v_base := lower(regexp_replace(p_name, '[^a-zA-Z0-9\u0600-\u06FF]+', '-', 'g'));
  v_base := trim(both '-' from v_base);
  IF v_base = '' THEN v_base := 'store'; END IF;
  
  v_slug := v_base;
  WHILE EXISTS(SELECT 1 FROM companies WHERE slug = v_slug) LOOP
    v_counter := v_counter + 1;
    v_slug := v_base || '-' || v_counter;
  END LOOP;
  
  RETURN v_slug;
END $$;

