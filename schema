FROM journal_entries je
JOIN journal_entry_lines jel ON jel.entry_id = je.id
JOIN chart_of_accounts coa ON coa.id = jel.account_id
WHERE je.status = 'posted'
GROUP BY je.company_id, je.entry_date;

