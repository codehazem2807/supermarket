-- 17.13 get_product_stock
CREATE OR REPLACE FUNCTION get_product_stock(
  p_product_id uuid, p_company_id uuid
) RETURNS numeric
LANGUAGE plpgsql SECURITY DEFINER SET search_path = public, pg_temp AS $$
DECLARE
  v_is_bundle boolean;
  v_stock numeric;
BEGIN
  SELECT is_bundle INTO v_is_bundle
  FROM products WHERE id = p_product_id AND company_id = p_company_id;

  IF v_is_bundle THEN
    SELECT COALESCE(MIN(FLOOR(COALESCE(sl.quantity_left, 0) / NULLIF(bi.quantity, 0))), 0)
    INTO v_stock
    FROM bundle_items bi
    LEFT JOIN (
      SELECT product_id, SUM(quantity_left) AS quantity_left
      FROM stock_lots WHERE company_id = p_company_id AND is_quarantined = false
      GROUP BY product_id
    ) sl ON sl.product_id = bi.component_product_id
    WHERE bi.bundle_product_id = p_product_id AND bi.company_id = p_company_id;
  ELSE
    SELECT COALESCE(SUM(quantity_left), 0)
    INTO v_stock
    FROM stock_lots
    WHERE product_id = p_product_id AND company_id = p_company_id AND is_quarantined = false;
  END IF;

  RETURN COALESCE(v_stock, 0);
END $$;

