-- 14.1 v_party_balances
DROP VIEW IF EXISTS v_party_balances CASCADE;
CREATE OR REPLACE VIEW v_party_balances AS
SELECT
  'customer'::text AS party_type,
  c.id AS party_id,
  c.company_id,
  c.name,
  c.phone,
  c.credit_limit,
  c.opening_balance,
  COALESCE(c.opening_balance, 0)
    + COALESCE((SELECT SUM(si.total) FROM sales_invoices si
        WHERE si.customer_id = c.id AND si.status IN ('credit', 'partial')), 0)
    - COALESCE((SELECT SUM(at.amount) FROM account_transactions at
        WHERE at.reference_type = 'customer' AND at.reference_id = c.id AND at.direction = 'in'), 0)
    + COALESCE((SELECT SUM(at.amount) FROM account_transactions at
        WHERE at.reference_type = 'customer' AND at.reference_id = c.id
          AND at.direction = 'out' AND at.operation_type = 'return'), 0)
  AS balance,
  COALESCE((SELECT SUM(si.total) FROM sales_invoices si
    WHERE si.customer_id = c.id AND si.status IN ('credit', 'partial')), 0) AS total_debt,
  COALESCE((SELECT SUM(at.amount) FROM account_transactions at
    WHERE at.reference_type = 'customer' AND at.reference_id = c.id AND at.direction = 'in'), 0) AS total_paid,
  c.is_active,
  c.deleted_at
FROM customers c
WHERE c.deleted_at IS NULL

UNION ALL

SELECT
  'supplier'::text AS party_type,
  s.id AS party_id,
  s.company_id,
  s.name,
  s.phone,
  NULL::numeric AS credit_limit,
  s.opening_balance,
  COALESCE(s.opening_balance, 0)
    + COALESCE((SELECT SUM(po.total) FROM purchase_orders po
        WHERE po.supplier_id = s.id AND po.status IN ('received', 'partially_received')), 0)
    - COALESCE((SELECT SUM(at.amount) FROM account_transactions at
        WHERE at.reference_type = 'supplier' AND at.reference_id = s.id AND at.direction = 'out'), 0)
  AS balance,
  COALESCE((SELECT SUM(po.total) FROM purchase_orders po
    WHERE po.supplier_id = s.id AND po.status IN ('received', 'partially_received')), 0) AS total_debt,
  COALESCE((SELECT SUM(at.amount) FROM account_transactions at
    WHERE at.reference_type = 'supplier' AND at.reference_id = s.id AND at.direction = 'out'), 0) AS total_paid,
  s.is_active,
  s.deleted_at
FROM suppliers s
WHERE s.deleted_at IS NULL;

-- 14.2 v_account_balances
CREATE OR REPLACE VIEW v_account_balances AS
SELECT a.id AS account_id, a.company_id, a.branch_id, a.name, a.account_type,
  COALESCE(a.opening_balance, 0) +
    COALESCE((SELECT SUM(CASE WHEN at.direction = 'in' THEN at.amount ELSE -at.amount END)
              FROM account_transactions at WHERE at.account_id = a.id), 0) AS balance
FROM accounts a;

